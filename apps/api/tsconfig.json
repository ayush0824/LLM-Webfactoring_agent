{
	"extends": "../../tooling/typescript/tsconfig.base.json",
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/__tests__/**"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"noUncheckedIndexedAccess": false,
		"skipLibCheck": true
	}
}
